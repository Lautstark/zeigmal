<?xml version="1.0" encoding="utf-8"?>
<!--
  NFC, and INTERNET.

  INTERNET is for one purpose: a card names a provider and a ref on its own
  sticker, and the clip is played from a link the provider hands out when the
  card comes in. Nothing is written to disk. The only outbound requests are the
  three the provider's own player makes (login, sign, link); core's
  SignDigitalProvider is the one place a URL is built, and nothing here uploads
  anything. See docs/architecture.md.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required, and meant: a station without NFC is a black screen. -->
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="true"
        tools:ignore="UnnecessaryRequiredFeature" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zeigmal"
        tools:targetApi="33">

        <!--
          Landscape, pinned. The Galaxy A51 is a phone, not a large screen, so
          Android honours a fixed orientation here — the tablet caveat recorded
          in vorlaut-app's AlwaysLandscape does not apply. sensorLandscape rather
          than landscape so the enclosure may hold the phone either way up.

          The configChanges list keeps a video playing through whatever the
          window does; nothing here is qualified by orientation.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
