<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing this app stores may be backed up to the cloud or transferred to another
  device. A Kartensatz holds licensed video and METACOM names, and Android's
  automatic backup is exactly the off-device path SPEC.md 5.2 forbids. Everything
  is excluded rather than one directory, because an allow-list somebody widens
  later is how the rule stops being true. Same file as in vorlaut-app.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
